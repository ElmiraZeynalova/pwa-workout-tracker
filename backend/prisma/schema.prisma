generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model app_users {
  id         String     @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  email      String     @unique(map: "users_email_key")
  password   String
  updated_at DateTime?  @default(now()) @db.Timestamptz(6)
  routines   routines[]
  workouts   workouts[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model exercises {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  workout_id String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workouts   workouts? @relation(fields: [workout_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sets       sets[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model routine_exercises {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  routine_id   String?        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routines     routines?      @relation(fields: [routine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  routine_sets routine_sets[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model routine_sets {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reps                Decimal            @db.Decimal
  weight              Float?             @db.Real
  routine_exercise_id String?            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routine_exercises   routine_exercises? @relation(fields: [routine_exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model routines {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  user_id           String?             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  updated_at        DateTime?           @default(now()) @db.Timestamptz(6)
  routine_exercises routine_exercises[]
  app_users         app_users?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sets {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercise_id String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reps        Int?
  weight      Float?    @db.Real
  exercises   exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model workouts {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       String      @unique
  updated_at DateTime    @default(now()) @db.Timestamptz(6)
  exercises  exercises[]
  app_users  app_users   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, date], map: "unique_user_date")
}
